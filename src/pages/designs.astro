---
import Room from "@/layouts/Room.astro";
import Button from "@/components/system/Button.astro";
import SectionHead from "@/components/system/SectionHead.astro";
import ServiceList from "@/components/system/ServiceList.astro";
import ProcessSteps from "@/components/system/ProcessSteps.astro";
import ContactPanel from "@/components/system/ContactPanel.astro";
import { DesignWall } from "@/components/design/DesignWall";
import { DESIGN_PROJECTS } from "@/data/designs";
import { cdn } from "@/data/site";

const SERVICES = [
  {
    marker: "01",
    title: "Product interfaces",
    copy: "Clear, responsive interfaces for web products, apps, dashboards, and tools, designed to make complex actions feel straightforward.",
    details: ["Web apps", "Dashboards", "Responsive UI"],
  },
  {
    marker: "02",
    title: "UX and product flows",
    copy: "Thoughtful journeys, wireframes, onboarding, and product states that help users understand where they are and what comes next.",
    details: ["User flows", "Wireframes", "Onboarding"],
  },
  {
    marker: "03",
    title: "Design systems",
    copy: "Reusable components, type, spacing, color, and interaction rules that keep a product consistent as it grows.",
    details: ["Components", "Typography", "UI foundations"],
  },
  {
    marker: "04",
    title: "Visual direction",
    copy: "A distinct visual language for landing pages, launch moments, and branded digital experiences without sacrificing usability.",
    details: ["Landing pages", "Art direction", "Campaign UI"],
  },
];

const PROCESS = [
  {
    step: "01",
    title: "Understand the problem",
    copy: "We align on the user, the product goal, the constraints, and what success needs to look like.",
  },
  {
    step: "02",
    title: "Shape the experience",
    copy: "I map the flow and structure first, so the screen solves the right problem before visual polish begins.",
  },
  {
    step: "03",
    title: "Design the system",
    copy: "The interface takes shape through hierarchy, responsive behavior, components, and purposeful visual detail.",
  },
  {
    step: "04",
    title: "Refine and hand off",
    copy: "Feedback becomes focused revisions and a clear design handoff that is practical to build from.",
  },
];

const TOOLS = ["Figma", "FigJam", "Canva", "Photoshop", "Illustrator", "Framer", "AI-assisted workflows"];

const HERO_FRAMES = [
  { src: cdn("design-1.webp"), width: 1662, height: 1080, class: "left-0 top-6 w-[62%] -rotate-2 z-10", delay: "0ms" },
  { src: cdn("design-4.webp"), width: 1662, height: 1080, class: "right-0 top-0 w-[46%] rotate-2", delay: "120ms" },
  { src: cdn("design-7.webp"), width: 1784, height: 842, class: "right-[6%] bottom-0 w-[58%] -rotate-1 z-20", delay: "240ms" },
];
---

<Room
  room="design"
  title="Sanchit, UI/UX Designer"
  description="Selected interface, product, and visual design work by Sanchit. Interfaces that feel clear from the first click."
>
  <section class="canvas-dots overflow-hidden pt-(--nav-height)">
    <div class="shell grid items-center gap-10 py-12 md:py-20 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-7">
        <p class="t-label flex items-center gap-2 text-muted">
          <span class="size-2 rounded-full bg-accent"></span>
          Product designer / available for projects
        </p>
        <h1 class="t-display t-xl animate-rise mt-6 lg:text-[clamp(3.25rem,7.4vw,8rem)]">
          Interfaces that feel <span class="selected-word"><em>clear</em></span> from the first click.
        </h1>
        <p class="t-lede mt-7 max-w-xl">
          I design digital products that turn complicated ideas into focused, useful experiences,
          balancing product thinking with a visual system people can understand and trust.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="#work" size="lg" arrow={false}>See the work</Button>
          <Button href="#contact" size="lg" variant="ghost" arrow={false}>Start a project</Button>
        </div>
      </div>

      <div class="relative aspect-5/4 lg:col-span-5" aria-hidden="true">
        {
          HERO_FRAMES.map((frame) => (
            <img
              src={frame.src}
              width={frame.width}
              height={frame.height}
              alt=""
              style={{ animationDelay: frame.delay }}
              class:list={[
                "animate-rise absolute h-auto rounded-room border border-line bg-surface shadow-[0_24px_60px_rgb(21_20_15/0.18)]",
                frame.class,
              ]}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section id="work" class="section shell">
    <SectionHead
      label="Selected work"
      title="Interface, layout, and visual direction."
      lede="Landing pages, pricing, marketing sites, and colour work. Open any frame to see it full size."
    />
    <DesignWall client:visible projects={DESIGN_PROJECTS} />
  </section>

  <section id="services" class="section shell pt-0">
    <SectionHead
      label="Design capabilities"
      title="From the first flow to the <em>finished</em> interface."
      lede="I can help shape the structure, the visual language, or the full experience, wherever the product needs clarity."
    />
    <ServiceList items={SERVICES} />
    <p class="t-label mt-8 text-faint">Toolkit: {TOOLS.join(" / ")}</p>
  </section>

  <section id="process" class="section shell pt-0">
    <SectionHead
      label="A clear process"
      title="From product question to build-ready design."
      lede="Enough structure to stay aligned, with room to explore the details that make the experience feel distinct."
    />
    <ProcessSteps steps={PROCESS} />
  </section>

  <ContactPanel
    label="Building something new?"
    title="Let's make it easier to understand and <em>harder to forget.</em>"
    lede="Tell me what you are building, who it is for, and where the experience feels unclear today."
    subject="Design project"
    cta="Discuss your project"
    briefTitle="Useful to include"
    brief={["What you are building", "Who it is for", "Where it feels unclear today", "A product you admire", "When you need it"]}
  />
</Room>
