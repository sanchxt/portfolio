---
import Room from "@/layouts/Room.astro";
import Button from "@/components/system/Button.astro";
import SectionHead from "@/components/system/SectionHead.astro";
import ServiceList from "@/components/system/ServiceList.astro";
import ProcessSteps from "@/components/system/ProcessSteps.astro";
import ContactPanel from "@/components/system/ContactPanel.astro";
import { EditSuite } from "@/components/video/EditSuite";
import { VIDEO_EDITS } from "@/data/videos";

const SERVICES = [
  {
    marker: "V1 / Short-form",
    title: "Short-form social",
    copy: "Reels and vertical edits shaped around a strong opening, clean pacing, captions, and sound-led momentum.",
  },
  {
    marker: "V2 / Talking head",
    title: "Talking-head edits",
    copy: "Confident cuts, readable captions, visual emphasis, and supporting moments that keep the message moving.",
  },
  {
    marker: "A1 / Music",
    title: "Song and montage edits",
    copy: "Fast, music-aware sequences with enough impact to feel energetic without losing the story or the moment.",
  },
  {
    marker: "FX / Motion",
    title: "Motion and loops",
    copy: "Polished motion details, seamless loops, and format-ready cuts for campaigns, music, and social posts.",
  },
];

const TOOLS = [
  "Premiere Pro",
  "After Effects",
  "CapCut",
  "DaVinci Resolve",
  "Photoshop",
  "Canva",
  "Figma",
  "Descript",
  "AI-assisted workflows",
];

const PROCESS = [
  {
    step: "00:00 / Footage",
    title: "Share the footage",
    copy: "Send the raw clips, references, platform, and what the edit needs to achieve.",
  },
  {
    step: "00:15 / Direction",
    title: "Set the direction",
    copy: "We align on pacing, visual language, music, captions, and the strongest opening.",
  },
  {
    step: "00:30 / Cut",
    title: "Edit and refine",
    copy: "I build the cut, shape the details, and refine it around clear, focused feedback.",
  },
  {
    step: "00:45 / Export",
    title: "Ready to publish",
    copy: "You receive a polished export built for the channel and format where it will live.",
  },
];
---

<Room
  room="video"
  title="Sanchit, Video Editor"
  description="Short-form, talking-head, song, and motion edits by Sanchit. Edits that make every second count."
  ogImage="/og-video.png"
>
  <EditSuite client:load videos={VIDEO_EDITS}>
    <p class="t-label text-muted">Video editor / available for projects</p>
    <h1 class="t-display t-xl animate-rise mt-5 lg:text-[clamp(3.5rem,min(9.5vw,14svh),12rem)]">
      Edits that make <span class="bg-linear-to-r from-ink to-ink bg-center bg-no-repeat px-[0.08em] text-bg [background-size:100%_0.84em] [box-decoration-break:clone]">every second</span> count.
    </h1>
    <p class="t-lede mt-6 max-w-xl">
      I turn raw footage into sharp, watchable stories for creators, brands, and social feeds,
      built around pacing, clarity, and the moments people remember.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="#work" size="lg" arrow={false}>Watch the edits</Button>
      <Button href="#contact" size="lg" variant="ghost" arrow={false}>Start an edit</Button>
    </div>
  </EditSuite>

  <section id="services" class="section shell">
    <SectionHead label="How I can help" title="Editing built around the way people watch." />
    <ServiceList items={SERVICES} />
  </section>

  <section class="screening overflow-hidden py-5" aria-label="Editing tools">
    <ul class="marquee">
      {
        [...TOOLS, ...TOOLS].map((tool, index) => (
          <li
            class="t-display t-md flex items-center whitespace-nowrap pr-8 md:pr-12"
            aria-hidden={index >= TOOLS.length ? "true" : undefined}
          >
            {tool}
            <span class="ml-8 size-2 rounded-full bg-accent md:ml-12" />
          </li>
        ))
      }
    </ul>
  </section>

  <section id="process" class="section shell">
    <SectionHead
      label="A clear workflow"
      title="From raw footage to final cut."
      lede="Simple communication, a clear creative direction, and an edit shaped for where it will be watched."
    />
    <ProcessSteps steps={PROCESS} />
  </section>

  <ContactPanel
    label="Have footage in mind?"
    title="Let's turn it into something worth watching."
    lede="Tell me what you are making, where it will live, and what you want the viewer to feel."
    subject="Video editing project"
    cta="Discuss your edit"
    briefTitle="Useful to include"
    brief={["What you are making", "Platform and format", "Length of the raw footage", "An edit you like", "When you need it"]}
  />
</Room>
