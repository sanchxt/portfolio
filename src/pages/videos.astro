---
import "../styles/global.css";
import { Navbar } from "@/components/ui/navbar";
import { Footer } from "@/components/ui/footer";
import { FluidCursor } from "@/components/ui/fluid-cursor";
import { VideoEditsGallery } from "@/components/ui/video-edits-gallery";

const CDN_URL = import.meta.env.PUBLIC_CDN_URL || "";

const getCdnAssetUrl = (path: string) => (CDN_URL ? `${CDN_URL}/${path}` : "");

const VIDEO_EDITS = [
  {
    title: "Messi vertical",
    filename: "messi-vertical.mp4",
    format: "9:16",
    orientation: "vertical" as const,
  },
  {
    title: "Travel vertical",
    filename: "travel-vertical.mp4",
    format: "9:16",
    orientation: "vertical" as const,
  },
  {
    title: "Katie vertical",
    filename: "katie-vertical.mp4",
    format: "9:16",
    orientation: "vertical" as const,
  },
  {
    title: "Talking head edit",
    filename: "talking-1.webm",
    duration: "00:52",
    format: "16:9",
    dimensions: "1280 x 720",
    orientation: "landscape" as const,
  },
  {
    title: "COD vertical",
    filename: "cod-vertical.mp4",
    format: "9:16",
    orientation: "vertical" as const,
  },
  {
    title: "Song loop",
    filename: "song-loop.webm",
    duration: "02:17",
    format: "1:1",
    dimensions: "1254 x 1254",
    orientation: "square" as const,
  },
  {
    title: "Time edit",
    filename: "time.webm",
    duration: "00:22",
    format: "9:16",
    dimensions: "720 x 1280",
    orientation: "vertical" as const,
  },
  {
    title: "Talking reel edit",
    filename: "talking-2.webm",
    duration: "00:53",
    format: "9:16",
    dimensions: "720 x 1280",
    orientation: "vertical" as const,
  },
  {
    title: "Gaming edit",
    filename: "gaming.webm",
    duration: "00:31",
    format: "9:16",
    dimensions: "720 x 1280",
    orientation: "vertical" as const,
  },
].map((video) => ({
  ...video,
  source: getCdnAssetUrl(`videos-edits/${video.filename}`),
}));

const EDITING_VALUES = [
  {
    title: "Rhythm first",
    copy: "Cuts, pauses, captions, and sound need to move together so the viewer never feels dragged.",
  },
  {
    title: "Readable motion",
    copy: "The edit can be energetic without making the message harder to follow.",
  },
  {
    title: "Platform fit",
    copy: "Aspect ratio, first frame, caption density, and pacing are shaped for short-form viewing habits.",
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/icon.webp" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Video Editing - Sanchit</title>
  </head>
  <body class="bg-page-bg">
    <FluidCursor client:load />
    <Navbar client:load />

    <main class="min-h-screen w-full max-w-full overflow-x-hidden pt-32 pb-24">
      <section class="w-full max-w-7xl mx-auto px-4 py-16 md:py-28">
        <div class="grid gap-10 lg:grid-cols-[minmax(0,0.95fr)_minmax(18rem,0.5fr)] lg:items-end">
          <div class="max-w-6xl">
            <h1 class="max-w-6xl text-[clamp(3rem,8vw,7.5rem)] font-semibold leading-[0.92] text-text-heading">
              video editing
            </h1>
            <p class="mt-8 max-w-3xl text-lg md:text-xl leading-8 text-text-secondary">
              Short-form edits with clean pacing, caption rhythm, motion beats,
              sound texture, and enough restraint to keep the idea clear.
            </p>
          </div>

          <div class="border-t border-border-default pt-6 lg:border-t-0 lg:border-l lg:pl-8">
            <p class="text-text-secondary leading-relaxed">
              The gallery below loads progressively from Cloudflare R2, so the
              page can stay light while still showing the actual edits.
            </p>
            <div class="mt-8 flex flex-wrap gap-5">
              <a
                href="/#contact"
                class="font-medium text-text-secondary transition-colors duration-200 hover:text-text-heading hover:underline hover:decoration-2 underline-offset-4"
              >
                Discuss an edit -&gt;
              </a>
              <a
                href="/designs"
                class="font-medium text-text-secondary transition-colors duration-200 hover:text-text-heading hover:underline hover:decoration-2 underline-offset-4"
              >
                View design work -&gt;
              </a>
            </div>
          </div>
        </div>
      </section>

      <section class="w-full max-w-7xl mx-auto px-4 py-20 md:py-32">
        <div class="mb-12 grid gap-5 md:grid-cols-[minmax(0,0.75fr)_minmax(0,1fr)] md:items-end">
          <h2 class="text-3xl md:text-5xl font-semibold leading-tight text-text-heading">
            selected short-form edits
          </h2>
          <p class="text-text-secondary leading-relaxed md:text-right">
            A compact gallery for vertical reels, motion cuts, talking-head
            edits, and loops. Each video source is attached only as it nears
            the viewport.
          </p>
        </div>

        <VideoEditsGallery client:load videos={VIDEO_EDITS} />
      </section>

      <section class="w-full max-w-6xl mx-auto px-4 py-20 md:py-32">
        <div class="mb-12 flex justify-end">
          <h2 class="group relative inline-block text-right text-3xl md:text-4xl font-semibold text-text-heading cursor-pointer">
            edit notes
            <span class="absolute -bottom-1 right-0 h-1 w-20 bg-text-heading rounded-xs transition-all duration-300 ease-in-out group-hover:w-full"></span>
          </h2>
        </div>

        <div class="grid gap-6 md:grid-cols-3">
          {
            EDITING_VALUES.map((value) => (
              <article class="group border-t border-border-default py-7">
                <h3 class="text-xl md:text-2xl font-semibold text-text-heading transition-colors duration-200 group-hover:text-text-accent">
                  {value.title}
                </h3>
                <p class="mt-4 text-text-secondary leading-relaxed">
                  {value.copy}
                </p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="w-full max-w-6xl mx-auto px-4 py-20 md:py-32">
        <div class="border-y border-border-default py-10 md:py-14">
          <p class="max-w-5xl text-2xl md:text-4xl leading-tight text-text-heading">
            Good editing feels invisible when it needs to, sharp when it
            should, and never confused about what the viewer should notice next.
          </p>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
