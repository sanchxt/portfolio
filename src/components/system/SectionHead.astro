---
interface Props {
  label: string;
  title: string;
  lede?: string;
}

const { label, title, lede } = Astro.props;
---

<header
  class="mb-12 grid gap-6 border-t border-line pt-5 md:mb-20 lg:grid-cols-12"
  data-reveal
>
  <p class="t-label text-faint lg:col-span-3">{label}</p>
  <div class="lg:col-span-9">
    <h2 class="t-display t-lg max-w-[18ch]" set:html={title} />
    {lede && <p class="t-lede mt-6 max-w-2xl">{lede}</p>}
  </div>
</header>
