---
interface Props {
  steps: { step: string; title: string; copy: string }[];
}

const { steps } = Astro.props;
---

<ol class="grid gap-px overflow-hidden rounded-room border border-line bg-line sm:grid-cols-2 xl:grid-cols-4">
  {
    steps.map((item) => (
      <li class="flex min-h-56 flex-col bg-bg p-6 md:min-h-72 md:p-7" data-reveal>
        <span class="t-label text-accent">{item.step}</span>
        <h3 class="mt-auto pt-10 text-2xl font-semibold tracking-tight">{item.title}</h3>
        <p class="mt-3 leading-relaxed text-muted">{item.copy}</p>
      </li>
    ))
  }
</ol>
